---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { Arrow } from '../../components/ui/Button.jsx';
import { Container, Label, formatDate } from '../../components/ui/Layout.jsx';
import { getPosts } from '../../lib/posts';
import '../../styles/blog.css';

export async function getStaticPaths() {
  const posts = await getPosts(); // newest first
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: {
      post,
      number: posts.length - i, // oldest post is No. 01
      next: posts.length > 1 ? posts[(i + 1) % posts.length] : null,
    },
  }));
}

const { post, number, next } = Astro.props;
const { Content } = await render(post);
const date = post.data.date.toISOString().slice(0, 10);
const words = (post.body || '').split(/\s+/).filter(Boolean).length;
const minutes = Math.max(1, Math.round(words / 220));
const no = String(number).padStart(2, '0');
const url = new URL(`/blog/${post.id}`, Astro.site).toString();
const share = {
  x: `https://twitter.com/intent/tweet?text=${encodeURIComponent(post.data.title)}&url=${encodeURIComponent(url)}`,
  facebook: `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(url)}`,
};
const cover = post.data.coverImage;
---

<Base title={post.data.title} description={post.data.excerpt} image={cover}>
  <!-- Reading progress -->
  <div class="fixed inset-x-0 top-0 z-[55] h-[3px] pointer-events-none" aria-hidden="true">
    <div id="read-progress" class="h-full w-full origin-left scale-x-0 bg-nn-brand"></div>
  </div>

  <article class="article bg-nn-bg pt-32 md:pt-40 pb-24 md:pb-40">
    <!-- Header: headline beside the cover, taped to the page -->
    <Container>
      <a
        href="/blog"
        class="intro-rise label inline-flex items-center gap-2 text-nn-muted hover:text-nn-text transition-colors duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-nn-text rounded-nn"
      >
        <Arrow className="rotate-180" /> All news
      </a>

      <div class:list={['mt-10 grid gap-12 md:gap-10 md:items-center', cover && 'md:grid-cols-12']}>
        <div class:list={[cover ? 'md:col-span-7' : 'max-w-[1100px]']}>
          <div class="intro-rise flex flex-wrap items-center gap-x-4 gap-y-2" style="--d: 80ms">
            <span class="label bg-nn-brand text-nn-on-brand px-2 py-1">Dispatch No. {no}</span>
            <Label as="time" dateTime={date}>{formatDate(date)}</Label>
            <Label className="text-nn-subtle">{minutes} min read</Label>
          </div>
          <h1
            style="--d: 160ms"
            class="intro-title display mt-8 text-nn-text text-[min(10vw,44px)] md:text-[clamp(48px,5.4vw,96px)] leading-[0.92]"
          >
            {post.data.title}
          </h1>
          {
            post.data.excerpt && (
              <p class="intro-rise mt-8 max-w-[560px] text-lead text-nn-muted" style="--d: 300ms">
                {post.data.excerpt}
              </p>
            )
          }
        </div>

        {
          cover && (
            <div class="md:col-span-5 intro-media" style="--d: 360ms">
              <figure class="taped relative mx-auto max-w-[520px] rotate-[2deg] transition-transform duration-500 ease-out hover:rotate-0">
                <span class="tape" aria-hidden="true" />
                <img
                  src={cover}
                  alt=""
                  class="block w-full max-h-[70vh] object-cover rounded-nn shadow-e6 bg-nn-surface"
                />
              </figure>
            </div>
          )
        }
      </div>
    </Container>

    <!-- Body with a sticky side rail -->
    <Container className="mt-20 md:mt-32">
      <div class="grid gap-10 md:grid-cols-12">
        <aside class="md:col-span-3 intro-rise" style="--d: 480ms">
          <div class="md:sticky md:top-28 flex flex-row flex-wrap items-center gap-x-6 gap-y-4 md:flex-col md:items-start border-y border-nn-line md:border-y-0 md:border-l md:pl-5 py-4 md:py-1">
            <div>
              <p class="label text-nn-subtle">Dispatch</p>
              <p class="display text-nn-text text-[40px] leading-none mt-1">{no}</p>
            </div>
            <div class="hidden md:block">
              <p class="label text-nn-subtle">Posted</p>
              <p class="mt-1 text-body text-nn-text">{formatDate(date)}</p>
            </div>
            <div class="flex flex-wrap items-center gap-x-5 gap-y-2 md:flex-col md:items-start md:gap-1">
              <p class="label text-nn-subtle md:mb-1">Share</p>
              <button
                type="button"
                data-copy={url}
                class="share-link label text-nn-text hover:text-nn-brand transition-colors duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-nn-text rounded-nn"
              >
                Copy link
              </button>
              <a href={share.x} target="_blank" rel="noopener noreferrer" class="share-link label text-nn-text hover:text-nn-brand transition-colors duration-200">
                X / Twitter
              </a>
              <a href={share.facebook} target="_blank" rel="noopener noreferrer" class="share-link label text-nn-text hover:text-nn-brand transition-colors duration-200">
                Facebook
              </a>
            </div>
          </div>
        </aside>

        <div class="md:col-span-8 md:col-start-5 intro-rise" style="--d: 560ms">
          <div class="post-body">
            <Content />
          </div>
          <p class="mt-16 flex items-center gap-3 label text-nn-subtle" aria-hidden="true">
            <span class="h-2 w-2 bg-nn-brand"></span> End of dispatch {no}
          </p>
        </div>
      </div>
    </Container>

    <!-- Next dispatch -->
    {
      next && next.id !== post.id && (
        <Container className="mt-24 md:mt-32">
          <a
            href={`/blog/${next.id}`}
            class="next-card group relative block overflow-hidden rounded-nn bg-nn-surface focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-nn-text focus-visible:ring-offset-4 focus-visible:ring-offset-nn-bg"
          >
            {next.data.coverImage && (
              <img
                src={next.data.coverImage}
                alt=""
                loading="lazy"
                class="photo-bw absolute inset-0 h-full w-full object-cover opacity-40 transition-[opacity,transform,filter] duration-700 ease-out group-hover:opacity-60 group-hover:scale-[1.03] group-hover:[filter:none]"
              />
            )}
            <span class="absolute inset-0 bg-gradient-to-r from-nn-bg via-nn-bg/80 to-nn-bg/20" aria-hidden="true" />
            <span class="relative flex min-h-[320px] md:min-h-[420px] flex-col justify-between gap-10 p-8 md:p-12">
              <span class="label text-nn-muted">Next dispatch</span>
              <span class="flex items-end justify-between gap-6">
                <span class="display text-nn-text text-[32px] md:text-[64px] leading-[0.92] max-w-[16ch] transition-colors duration-300 group-hover:text-nn-brand">
                  {next.data.title}
                </span>
                <span class="shrink-0 h-14 w-14 md:h-16 md:w-16 rounded-full bg-nn-text text-nn-bg flex items-center justify-center transition-transform duration-300 group-hover:translate-x-1">
                  <Arrow className="h-6 w-6" />
                </span>
              </span>
            </span>
          </a>
        </Container>
      )
    }
  </article>

  <script>
    // Reading progress bar
    const bar = document.getElementById('read-progress');
    const article = document.querySelector('.article .post-body');
    if (bar && article) {
      const update = () => {
        const rect = article.getBoundingClientRect();
        const total = rect.height - window.innerHeight * 0.6;
        const done = Math.min(1, Math.max(0, (window.innerHeight * 0.4 - rect.top) / Math.max(1, total)));
        bar.style.transform = `scaleX(${done})`;
      };
      update();
      window.addEventListener('scroll', update, { passive: true });
      window.addEventListener('resize', update);
    }

    // Copy link
    document.querySelectorAll('[data-copy]').forEach((btn) => {
      btn.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(btn.getAttribute('data-copy'));
          btn.textContent = 'Link copied';
        } catch {
          btn.textContent = 'Copy failed';
        }
        setTimeout(() => (btn.textContent = 'Copy link'), 2000);
      });
    });
  </script>
</Base>
